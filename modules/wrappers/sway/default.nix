# sway, wrapped: `config` is rendered from `passthru.settings` and
# `passthru.theme` and handed over with `--config`. The lightweight
# alternative to niri and Hyprland; the roles are independent of each other.
#
#   settings.binds        "Mod4+t" -> sway command, e.g. `exec foot`
#   settings.lockedBinds  likewise, but they also work on the lock screen
#   settings.startup      shell commands run once when sway starts
#   settings.launcher     command that toggles the launcher; bound when set
#   settings.lock         argv that locks the screen; bound to Mod4+Shift+l when set
#   settings.extraConfig  appended verbatim
#
# The config is sway's own, see sway(5).
{ self, lib, ... }:
let
  w = self.lib.wrappers;

  program = pkgs: [
    (w.withPackage pkgs.sway)
    {
      passthru.settings = {
        binds = _: { };
        lockedBinds = _: { };
        startup = _: [ ];
        launcher = _: null;
        lock = _: null;
        extraConfig = _: "";
      };
      # swaymsg and swaybar don't take --config
      passthru.wrapper.exes = _: [ "sway" ];
    }
    (
      final:
      let
        s = final.passthru.settings;
        c = self.lib.theme.hash final.passthru.theme.colors;

        bind =
          flags: key: cmd:
          "bindsym ${flags}${key} ${cmd}";
        binds =
          lib.mapAttrsToList (bind "") (
            s.binds
            // lib.optionalAttrs (s.launcher != null) { "Mod4+space" = "exec ${s.launcher}"; }
            // lib.optionalAttrs (s.lock != null) { "Mod4+Shift+l" = "exec ${lib.escapeShellArgs s.lock}"; }
          )
          ++ lib.mapAttrsToList (bind "--locked ") s.lockedBinds;

        config = ''
          # generated by the sway wrapper
          input type:keyboard {
              xkb_layout de,us
              xkb_variant ,dvorak
              xkb_options grp:caps_toggle
          }
          input type:touchpad tap enabled

          default_border pixel 4
          gaps inner 8
          gaps outer 8
          client.focused ${c.base0D} ${c.base0D} ${c.base00} ${c.base0D} ${c.base0D}
          client.unfocused ${c.base03} ${c.base03} ${c.base04} ${c.base03} ${c.base03}
          client.urgent ${c.base08} ${c.base08} ${c.base00} ${c.base08} ${c.base08}

          ${lib.concatStringsSep "\n" binds}

          ${lib.concatMapStringsSep "\n" (cmd: "exec ${cmd}") s.startup}

          ${s.extraConfig}
        '';
      in
      {
        passthru.files."config" = _: config;
        passthru.wrapper.flags.__append = [ "--config ${final.passthru.config.file."config"}" ];
      }
    )
  ];

  personal =
    packages: _final:
    let
      ws = map toString (lib.range 1 9);
    in
    {
      passthru.settings = {
        binds =
          _:
          {
            "Mod4+t" = "exec ${lib.getExe packages.alacritty}";
            # by name: the librewolf role installs the host's build, with its extensions
            "Mod4+d" = "exec librewolf";
            "Mod4+q" = "kill";
            "Mod4+Shift+e" = "exit";
            "Mod4+f" = "fullscreen";
            "Mod4+Shift+space" = "floating toggle";
            "Mod4+h" = "focus left";
            "Mod4+j" = "focus down";
            "Mod4+k" = "focus up";
            "Mod4+l" = "focus right";
            "Mod4+Shift+h" = "move left";
            "Mod4+Shift+j" = "move down";
            "Mod4+Shift+k" = "move up";
          }
          // lib.foldl' lib.mergeAttrs { } (
            map (n: {
              "Mod4+${n}" = "workspace number ${n}";
              "Mod4+Ctrl+${n}" = "move container to workspace number ${n}";
            }) ws
          );

        lockedBinds = _: {
          "XF86AudioRaiseVolume" = "exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+";
          "XF86AudioLowerVolume" = "exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
          "XF86AudioMute" = "exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
          "XF86AudioMicMute" = "exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
          "XF86MonBrightnessUp" = "exec brightnessctl -e4 -n2 set 5%+";
          "XF86MonBrightnessDown" = "exec brightnessctl -e4 -n2 set 5%-";
          "XF86AudioPlay" = "exec playerctl play-pause";
          "XF86AudioNext" = "exec playerctl next";
          "XF86AudioPrev" = "exec playerctl previous";
        };
      };
    };
in
{
  perSystem =
    { config, pkgs, ... }:
    {
      wrappers.sway = lib.mkMerge [
        (w.program (program pkgs))
        (lib.mkAfter [ (personal config.packages) ])
      ];

      checks.sway-config =
        pkgs.runCommand "check-sway-config" { nativeBuildInputs = [ pkgs.sway-unwrapped ]; }
          ''
            export XDG_RUNTIME_DIR=$TMPDIR WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
            sway --validate --config ${config.packages.sway.passthru.config.file."config"}
            touch $out
          '';
    };

  # Opt-in per host (`roles = [ "sway" ]`), next to or instead of `niri` and
  # `hyprland`. Takes what the other roles registered in `desktop.*`.
  flake.modules.nixos.sway =
    { config, pkgs, ... }:
    let
      sway = self.packages.${pkgs.stdenv.hostPlatform.system}.sway.extend {
        passthru.settings = {
          startup = old: old ++ config.desktop.startup;
          launcher = _: config.desktop.launcherCommand;
          lock = _: config.desktop.lock.command;
          extraConfig =
            old:
            old
            + lib.concatStrings (
              lib.mapAttrsToList (n: o: "output ${n} scale ${builtins.toJSON o.scale}\n") config.desktop.outputs
            );
        };
      };
    in
    {
      imports = [ self.modules.nixos.desktop ];

      programs.sway = {
        enable = true;
        package = sway;
      };

      desktop.sessions.sway = {
        name = "sway";
        exec = [ (lib.getExe' sway "sway") ];
        order = lib.mkDefault 30;
      };

      desktop.bar.items.SwayWorkspaces = {
        position = "left";
        order = 10;
        qml = ./Workspaces.qml;
      };
    };
}
