# niri, wrapped: `config.kdl` is rendered from `passthru.settings` and
# `passthru.theme` and found through `NIRI_CONFIG`, which is set on every
# executable: `niri-session` starts niri as a systemd user unit that cannot be
# given a flag, but inherits the session's environment.
#
#   settings.binds        "Mod+T" -> action, a KDL node: `spawn "foot"`
#   settings.lockedBinds  likewise, but they also work on the lock screen
#   settings.startup      shell commands run once when niri starts
#   settings.launcher     command that toggles the launcher; bound when set
#   settings.lock         command that locks the screen; bound to Mod+Shift+L when set
#   settings.extraConfig  appended verbatim
#
# The KDL is niri's own, see https://yalter.github.io/niri/Configuration%3A-Introduction.html.
# Less complete than the Hyprland wrapper on purpose: it is the stand-in until
# that one is finished.
{ self, lib, ... }:
let
  w = self.lib.wrappers;
  q = builtins.toJSON;

  spawn = argv: "spawn ${lib.concatMapStringsSep " " q (lib.toList argv)}";
  spawnSh = cmd: "spawn-sh ${q cmd}";

  program = pkgs: [
    (w.withPackage pkgs.niri)
    {
      passthru.settings = {
        binds = _: { };
        lockedBinds = _: { };
        startup = _: [ ];
        launcher = _: null;
        lock = _: null;
        extraConfig = _: "";
      };
      # niri starts it itself when it finds it in PATH
      passthru.path = _: [ pkgs.xwayland-satellite ];
    }
    (
      final:
      let
        s = final.passthru.settings;
        c = self.lib.theme.hash final.passthru.theme.colors;

        node =
          props: key: action:
          "    ${key}${props} { ${action}; }";
        binds =
          lib.mapAttrsToList (node "") (
            s.binds
            // lib.optionalAttrs (s.launcher != null) { "Mod+Space" = spawnSh s.launcher; }
            // lib.optionalAttrs (s.lock != null) { "Mod+Shift+L" = spawn s.lock; }
          )
          ++ lib.mapAttrsToList (node " allow-when-locked=true") s.lockedBinds;

        kdl = ''
          // generated by the niri wrapper
          prefer-no-csd

          input {
              keyboard {
                  xkb {
                      layout "de,us"
                      variant ",dvorak"
                      options "grp:caps_toggle"
                  }
                  numlock
              }
              touchpad { tap; }
          }

          cursor { hide-after-inactive-ms 2500; }

          layout {
              gaps 16
              preset-column-widths {
                  proportion 0.33333
                  proportion 0.5
                  proportion 0.66667
                  fixed 1000
              }
              default-column-width { proportion 0.5; }
              focus-ring { off; }
              border {
                  width 4
                  active-color ${q c.base0D}
                  inactive-color ${q c.base03}
                  urgent-color ${q c.base08}
              }
          }

          ${lib.concatMapStringsSep "\n" (cmd: "spawn-sh-at-startup ${q cmd}") s.startup}

          binds {
          ${lib.concatStringsSep "\n" binds}
          }

          ${s.extraConfig}
        '';
      in
      {
        passthru.files."config.kdl" = _: kdl;
        passthru.wrapper.env.NIRI_CONFIG.__assign = final.passthru.config.file."config.kdl";
      }
    )
  ];

  personal =
    packages: _final:
    let
      focusMove = key: dir: {
        "Mod+${key}" = "focus-column-${dir}";
        "Mod+Ctrl+${key}" = "move-column-${dir}";
      };
      workspace = n: {
        "Mod+${toString n}" = "focus-workspace ${toString n}";
        "Mod+Ctrl+${toString n}" = "move-column-to-workspace ${toString n}";
      };
    in
    {
      passthru.settings = {
        binds =
          _:
          {
            "Mod+T" = spawn (lib.getExe packages.alacritty);
            "Mod+D" = spawn (lib.getExe packages.librewolf);
            "Mod+Q" = "close-window";
            "Mod+Shift+E" = "quit";
            "Ctrl+Alt+Delete" = "quit";
            "Mod+Shift+P" = "power-off-monitors";

            "Mod+O" = "toggle-overview";
            "Mod+Shift+Numbersign" = "show-hotkey-overlay";

            "Mod+Down" = "focus-window-or-workspace-down";
            "Mod+J" = "focus-window-or-workspace-down";
            "Mod+Up" = "focus-window-or-workspace-up";
            "Mod+K" = "focus-window-or-workspace-up";
            "Mod+Ctrl+Down" = "move-window-down-or-to-workspace-down";
            "Mod+Ctrl+J" = "move-window-down-or-to-workspace-down";
            "Mod+Ctrl+Up" = "move-window-up-or-to-workspace-up";
            "Mod+Ctrl+K" = "move-window-up-or-to-workspace-up";

            "Mod+Home" = "focus-column-first";
            "Mod+End" = "focus-column-last";

            # Mod+Shift+L is the lock
            "Mod+Shift+Left" = "focus-monitor-left";
            "Mod+Shift+H" = "focus-monitor-left";
            "Mod+Shift+Right" = "focus-monitor-right";
            "Mod+Shift+Down" = "focus-monitor-down";
            "Mod+Shift+J" = "focus-monitor-down";
            "Mod+Shift+Up" = "focus-monitor-up";
            "Mod+Shift+K" = "focus-monitor-up";
            "Mod+Ctrl+Shift+Left" = "move-column-to-monitor-left";
            "Mod+Ctrl+Shift+H" = "move-column-to-monitor-left";
            "Mod+Ctrl+Shift+Right" = "move-column-to-monitor-right";
            "Mod+Ctrl+Shift+L" = "move-column-to-monitor-right";

            "Mod+U" = "focus-workspace-down";
            "Mod+I" = "focus-workspace-up";
            "Mod+Page_Down" = "focus-workspace-down";
            "Mod+Page_Up" = "focus-workspace-up";
            "Mod+Ctrl+U" = "move-column-to-workspace-down";
            "Mod+Ctrl+I" = "move-column-to-workspace-up";

            "Mod+Comma" = "consume-window-into-column";
            "Mod+Period" = "expel-window-from-column";
            "Mod+W" = "toggle-column-tabbed-display";

            "Mod+R" = "switch-preset-column-width";
            "Mod+Shift+R" = "switch-preset-window-height";
            "Mod+F" = "maximize-column";
            "Mod+Shift+F" = "fullscreen-window";
            "Mod+C" = "center-column";
            "Mod+Ssharp" = ''set-column-width "-10%"'';
            "Mod+Dead_Acute" = ''set-column-width "+10%"'';

            "Print" = "screenshot";
            "Ctrl+Print" = "screenshot-screen";
            "Alt+Print" = "screenshot-window";
          }
          // focusMove "H" "left"
          // focusMove "Left" "left"
          // focusMove "L" "right"
          // focusMove "Right" "right"
          // lib.foldl' lib.mergeAttrs { } (map workspace (lib.range 1 9));

        lockedBinds = _: {
          "XF86AudioRaiseVolume" = spawnSh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+";
          "XF86AudioLowerVolume" = spawnSh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
          "XF86AudioMute" = spawnSh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
          "XF86AudioMicMute" = spawnSh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
          "XF86MonBrightnessUp" = spawnSh "brightnessctl -e4 -n2 set 5%+";
          "XF86MonBrightnessDown" = spawnSh "brightnessctl -e4 -n2 set 5%-";
          "XF86AudioPlay" = spawnSh "playerctl play-pause";
          "XF86AudioStop" = spawnSh "playerctl stop";
          "XF86AudioNext" = spawnSh "playerctl next";
          "XF86AudioPrev" = spawnSh "playerctl previous";
        };
      };
    };
in
{
  perSystem =
    { config, pkgs, ... }:
    {
      wrappers.niri = lib.mkMerge [
        (w.program (program pkgs))
        (lib.mkAfter [ (personal config.packages) ])
      ];

      checks.niri-config = pkgs.runCommand "check-niri-config" { nativeBuildInputs = [ pkgs.niri ]; } ''
        niri validate --config ${config.packages.niri.passthru.config.file."config.kdl"}
        touch $out
      '';
    };

  # Opt-in per host (`roles = [ "niri" ]`), next to or instead of `hyprland`.
  # Takes what the other roles registered in `desktop.*`, like the Hyprland
  # role does, and adds its workspace widget to the bar.
  flake.modules.nixos.niri =
    { config, pkgs, ... }:
    let
      niri = self.packages.${pkgs.stdenv.hostPlatform.system}.niri.extend {
        passthru.settings = {
          startup = old: old ++ config.desktop.startup;
          launcher = _: config.desktop.launcherCommand;
          lock = _: config.desktop.lock.command;
          extraConfig =
            old:
            old
            + lib.concatStrings (
              lib.mapAttrsToList (n: o: "output ${q n} { scale ${q o.scale}; }\n") config.desktop.outputs
            );
        };
      };
    in
    {
      imports = [ self.modules.nixos.desktop ];

      programs.niri = {
        enable = true;
        package = niri;
      };

      desktop.sessions.niri = {
        name = "niri";
        exec = [ (lib.getExe' niri "niri-session") ];
        order = lib.mkDefault 20;
      };

      desktop.bar.items.NiriWorkspaces = {
        position = "left";
        order = 10;
        qml = ./Workspaces.qml;
      };
    };
}
