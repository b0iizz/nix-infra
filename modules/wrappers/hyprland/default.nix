# Hyprland, wrapped, with the Lua config (Hyprland >= 0.55): `hyprland.lua` is
# rendered from `passthru.settings` and handed over with `--config`.
#
#   settings.env         name -> value          hl.env
#   settings.monitors    hl.monitor tables
#   settings.config      hl.config table (general, input, decoration, ...)
#   settings.workspaces  hl.workspace_rule tables. The layout is also
#                        registered as `desktop.workspaces` (desktop.nix).
#   settings.binds       [ { keys, action, opts ? { } } ] -> hl.bind. `action`
#                        is a Lua expression, e.g. `exec [ "foot" ]` below or
#                        `raw "hl.dsp.window.close()"`.
#   settings.startup     shell commands run once when Hyprland starts
#   settings.launcher    command that toggles the launcher; bound when set
#   settings.lock        command that locks the screen; bound to SUPER+SHIFT+L when set
#   settings.extraLua    appended verbatim
#
# Only `start-hyprland` is wrapped, as that is what the session file runs
# (arguments after `--` reach Hyprland). Starting `Hyprland` directly reads
# the default config instead.
#
# The Lua tables are Hyprland's own, see https://wiki.hypr.land/configuring/.
{ self, lib, ... }:
let
  w = self.lib.wrappers;
  toLua = lib.generators.toLua { multiline = false; };
  raw = lib.generators.mkLuaInline;

  # `hl.dsp.exec_cmd` takes a shell command
  exec =
    cmd: raw "hl.dsp.exec_cmd(${toLua (if lib.isList cmd then lib.escapeShellArgs cmd else cmd)})";

  program = pkgs: [
    (w.withPackage pkgs.hyprland)
    {
      passthru.settings = {
        env = _: { };
        monitors = _: [
          {
            output = "";
            mode = "preferred";
            position = "auto";
            scale = "auto";
          }
        ];
        config = _: { };
        workspaces = _: [ ];
        binds = _: [ ];
        startup = _: [ ];
        launcher = _: null;
        lock = _: null;
        extraLua = _: "";
      };
      passthru.wrapper.exes = _: [ "start-hyprland" ];
      # the wrapper has only `out`, the package's `man` is not part of it
      meta.outputsToInstall = _: [ "out" ];
    }
    (
      final:
      let
        s = final.passthru.settings;
        h = w.fileHelpers pkgs;

        binds =
          s.binds
          ++ lib.optional (s.launcher != null) {
            keys = "SUPER + Space";
            action = exec s.launcher;
          }
          ++ lib.optional (s.lock != null) {
            keys = "SUPER + SHIFT + L";
            action = exec s.lock;
          };

        lua = lib.concatStringsSep "\n" (
          [ "-- generated by the hyprland wrapper" ]
          ++ lib.mapAttrsToList (n: v: "hl.env(${toLua n}, ${toLua v})") s.env
          ++ map (m: "hl.monitor(${toLua m})") s.monitors
          ++ lib.optional (s.config != { }) "hl.config(${toLua s.config})"
          ++ map (r: "hl.workspace_rule(${toLua r})") s.workspaces
          ++ map (
            b: "hl.bind(${toLua b.keys}, ${toLua b.action}${lib.optionalString (b ? opts) ", ${toLua b.opts}"})"
          ) binds
          ++ lib.optional (s.startup != [ ]) ''
            hl.on("hyprland.start", function()
            ${lib.concatMapStringsSep "\n" (c: "  hl.exec_cmd(${toLua c})") s.startup}
            end)''
          ++ [
            s.extraLua
            ""
          ]
        );
      in
      {
        passthru.files."hyprland.lua" = _: h.text lua;
        passthru.wrapper.flags.__append = [ "-- --config ${final.passthru.config.file."hyprland.lua"}" ];
      }
    )
  ];

  personal =
    packages: final:
    let
      t = final.passthru.theme;
      c = t.colors;
      mod = "SUPER";
      key = k: "${mod} + ${k}";
      locked = {
        locked = true;
        repeating = true;
      };
      ws = map toString (lib.range 1 9);
    in
    {
      passthru.settings = {
        config = _: {
          general = {
            layout = "scrolling";
            gaps_in = 8;
            gaps_out = 16;
            border_size = 4;
            col = {
              active_border = "rgb(${c.base0D})";
              inactive_border = "rgb(${c.base03})";
            };
          };
          input = {
            kb_layout = "de,us";
            kb_variant = ",dvorak";
            kb_options = "grp:caps_toggle";
            follow_mouse = 1;
          };
        };

        workspaces =
          _:
          map (n: {
            workspace = n;
            persistent = true;
          }) ws;

        binds =
          _:
          [
            {
              keys = key "T";
              action = exec (lib.getExe packages.alacritty);
            }
            {
              keys = key "D";
              action = exec (lib.getExe packages.librewolf);
            }
            {
              keys = key "Q";
              action = raw "hl.dsp.window.close()";
            }
            {
              keys = key "SHIFT + E";
              action = raw "hl.dsp.exit()";
            }
          ]
          ++
            lib.mapAttrsToList
              (k: dir: {
                keys = key k;
                action = raw "hl.dsp.focus(${toLua { direction = dir; }})";
              })
              {
                H = "left";
                J = "down";
                K = "up";
                L = "right";
              }
          ++ lib.concatMap (n: [
            {
              keys = key n;
              action = raw "hl.dsp.focus(${toLua { workspace = lib.toInt n; }})";
            }
            {
              keys = key "SHIFT + ${n}";
              action = raw "hl.dsp.window.move(${toLua { workspace = lib.toInt n; }})";
            }
          ]) ws
          ++ [
            {
              keys = "XF86AudioRaiseVolume";
              action = exec "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+";
              opts = locked;
            }
            {
              keys = "XF86AudioLowerVolume";
              action = exec "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-";
              opts = locked;
            }
            {
              keys = "XF86AudioMute";
              action = exec "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
              opts = locked;
            }
            {
              keys = "XF86MonBrightnessUp";
              action = exec "brightnessctl -e4 -n2 set 5%+";
              opts = locked;
            }
            {
              keys = "XF86MonBrightnessDown";
              action = exec "brightnessctl -e4 -n2 set 5%-";
              opts = locked;
            }
            {
              keys = "XF86AudioPlay";
              action = exec "playerctl play-pause";
              opts.locked = true;
            }
            {
              keys = "XF86AudioNext";
              action = exec "playerctl next";
              opts.locked = true;
            }
            {
              keys = "XF86AudioPrev";
              action = exec "playerctl previous";
              opts.locked = true;
            }
          ];
      };
    };
in
{
  perSystem =
    { config, pkgs, ... }:
    {
      wrappers.hyprland = lib.mkMerge [
        (w.program (program pkgs))
        (lib.mkAfter [ (personal config.packages) ])
      ];
    };

  # Opt-in per host (`roles = [ "hyprland" ]`). Whatever other roles asked for
  # through `desktop.*` (modules/desktop.nix) is added to the wrapper here, and
  # the workspaces are registered there for a shell, if the host has one.
  #
  # ponytail: the session file (share/wayland-sessions/hyprland.desktop) in the
  # wrapper still points at the unwrapped start-hyprland, so a display manager
  # that reads session files starts Hyprland without this config until it is
  # rewritten like `fixDesktopEntries` does for share/applications;
  # `providedSessions` is not forwarded either. The `greeter` role is not
  # affected: it runs `desktop.session`, the wrapped command, directly.
  flake.modules.nixos.hyprland =
    { config, pkgs, ... }:
    let
      hyprland = self.packages.${pkgs.stdenv.hostPlatform.system}.hyprland;
    in
    {
      imports = [ self.modules.nixos.desktop ];

      programs.hyprland = {
        enable = true;
        package = hyprland.extend {
          passthru.settings = {
            startup = old: old ++ config.desktop.startup;
            launcher = _: config.desktop.launcherCommand;
            lock = _: config.desktop.lock.command;
          };
        };
      };

      desktop.workspaces = map (r: {
        name = lib.removePrefix "name:" r.workspace;
        monitor = r.monitor or null;
      }) hyprland.passthru.settings.workspaces;

      desktop.session = [ (lib.getExe' config.programs.hyprland.package "start-hyprland") ];

      desktop.power.actions.logout = {
        name = "Log out";
        exec = [
          "hyprctl"
          "dispatch"
          "hl.dsp.exit()"
        ];
        order = 40;
        confirm = true;
      };

      desktop.bar.items.Workspaces = {
        position = "left";
        order = 10;
        qml = ./Workspaces.qml;
      };
    };
}
